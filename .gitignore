# Secrets and environment variables
.env
.env.*
*.key
*.pem

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Project-specific
# Exclude the contents, not the directory itself, so the negation below works
# (git never descends into an excluded directory).
raw-images/*
# The brand logo is a build input: tools/gen_favicons.py generates the icons from it
!raw-images/favicon.png
libsidplayfp/

# CRT files (stored in cloud storage)
crt/*